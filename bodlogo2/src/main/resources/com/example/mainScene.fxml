<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="360.0" prefWidth="500.0"
      spacing="16.0"
      style="-fx-background-color: #f0fdfa;"
      xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.Controller">

   <padding>
      <Insets top="28.0" right="36.0" bottom="28.0" left="36.0" />
   </padding>

   <Label text="RGB7011 - Минут секунд"
          style="-fx-text-fill: #115e59; -fx-font-weight: bold;">
      <font>
         <Font size="24.0" />
      </font>
   </Label>

   <Label text="Өгөгдсөн секундийг минут, секунд болгон хөрвүүлнэ."
          style="-fx-text-fill: #52706d;" />

   <TextField fx:id="txt_sek"
              maxWidth="300.0"
              onAction="#onAction"
              promptText="Секунд оруулна уу"
              style="-fx-background-radius: 8; -fx-padding: 10;" />

   <Button maxWidth="300.0"
           onAction="#onAction"
           text="Хөрвүүлэх"
           style="-fx-background-color: #0f766e;
                  -fx-background-radius: 8;
                  -fx-text-fill: white;
                  -fx-font-weight: bold;
                  -fx-padding: 10 18 10 18;" />

   <HBox alignment="CENTER" spacing="14.0">
      <Label text="Минут:" style="-fx-text-fill: #52706d;" />
      <Label fx:id="lbl_min"
             minWidth="70.0"
             alignment="CENTER"
             style="-fx-background-color: white;
                    -fx-background-radius: 8;
                    -fx-border-color: #b7dedb;
                    -fx-border-radius: 8;
                    -fx-font-size: 20;
                    -fx-font-weight: bold;
                    -fx-padding: 8;" />

      <Label text="Секунд:" style="-fx-text-fill: #52706d;" />
      <Label fx:id="lbl_sek"
             minWidth="70.0"
             alignment="CENTER"
             style="-fx-background-color: white;
                    -fx-background-radius: 8;
                    -fx-border-color: #b7dedb;
                    -fx-border-radius: 8;
                    -fx-font-size: 20;
                    -fx-font-weight: bold;
                    -fx-padding: 8;" />
   </HBox>
</VBox>